# Names only; put real values in a gitignored .env. Never commit keys.
# wallet seed file and index book (defaults .demo/seed, .demo/index-book.json)
ZSWAP_SEED=
ZSWAP_BOOK=
# binaries (or build them in packages/wallet-core and packages/scan, or set CARGO_TARGET_DIR)
ZSWAP_KEYS_BIN=
ZSWAP_SCAN_BIN=
CARGO_TARGET_DIR=
# lightwalletd (default https://testnet.zec.rocks:443) and 1Click
ZSWAP_LWD_URL=
ZSWAP_ONECLICK_URL=
# optional: quotes work without it
ONECLICK_JWT=
ZSWAP_MCP_LOG=
# examples (live run)
ZSWAP_FUNDER_WALLET=
ZSWAP_ZINGO_CLI=
